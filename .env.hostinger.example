# Copie para .env no VPS, aplique permissão 600 e preencha no editor local.
# O arquivo .env é privado e já está ignorado pelo Git e pelo build Docker.
# Use somente o domínio: sem https://, caminho ou porta.
SAHARA_DOMAIN=

# Informe sua senha exclusiva com pelo menos oito caracteres.
# Aspas simples impedem que o Compose interprete caracteres como $.
# Nenhuma senha padrão é fornecida.
SAHARA_ADMIN_PASSWORD=''

# Origem do cardápio atual. Acrescente outras origens somente se necessário.
SAHARA_ALLOWED_ORIGINS=https://saharaesfihas-card.github.io
